{
  "name": "ui-architect-skill",
  "version": "1.0.0",
  "description": "Design system orchestrator for AI coding agents — 31 style specs, Flow system, blocking task lists, and automated QA",
  "type": "module",
  "bin": {
    "ui-architect-skill": "./bin/ui-architect-skill.mjs"
  },
  "files": [
    "SKILL.md",
    "VERSION",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "install.sh",
    "uninstall.sh",
    "styles/",
    "token-cards/",
    "reference/",
    "scripts/",
    "bin/",
    "skills/",
    ".claude-plugin/",
    "docs/"
  ],
  "scripts": {
    "help": "node bin/ui-architect-skill.mjs help",
    "install:skill": "node bin/ui-architect-skill.mjs install",
    "uninstall:skill": "node bin/ui-architect-skill.mjs uninstall",
    "status": "node bin/ui-architect-skill.mjs status",
    "plugin-path": "node bin/ui-architect-skill.mjs plugin-path",
    "prepack": "node bin/ui-architect-skill.mjs help >/dev/null",
    "lint:scripts": "bash -n install.sh uninstall.sh scripts/qa-lint.sh scripts/status.sh scripts/normalize-styles.sh"
  },
  "keywords": [
    "ui",
    "design-system",
    "ai",
    "claude-code",
    "amp",
    "gemini",
    "style-specification",
    "design-tokens",
    "flow",
    "qa",
    "agent-skill",
    "plugin",
    "claude",
    "opencode",
    "design",
    "frontend"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scooter-lacroix/Ui-Design-Skill.git",
    "directory": "."
  },
  "homepage": "https://github.com/scooter-lacroix/Ui-Design-Skill#readme",
  "bugs": {
    "url": "https://github.com/scooter-lacroix/Ui-Design-Skill/issues"
  },
  "author": "scooter-lacroix",
